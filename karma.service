[Unit]
Description=Reddit Karma Tracker App

[Service]
Type=simple
WorkingDirectory=%h/karma_track
Environment="PATH=%h/karma_track/.venv/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="UV_NO_PROGRESS=1"
ExecStartPre=%h/.local/bin/uv sync --locked --no-dev --managed-python
ExecStart=%h/karma_track/.venv/bin/python %h/karma_track/entry.py run
Restart=on-failure
RestartSec=5
SyslogIdentifier=karma-tracker

[Install]
WantedBy=default.target
